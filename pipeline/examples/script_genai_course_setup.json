      "start": 16.084,
      "end": 22.06
    },
    {
      "speaker": "B",
      "text": "120 核心小時加 60 GB 小時。",
      "audio_file": "audio/lines/tts_genai_course_setup_line0007_B.mp3",
      "start": 22.18,
      "end": 25.516
    },
    {
      "speaker": "A",
      "text": "聽起來挺夠用的嘛。",
